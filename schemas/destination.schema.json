{"$id":"china-travel-atlas/destination.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"目的地数据标准 v1。机器校验由 tools/validate-data.mjs 按本文件实现（无第三方依赖）。实时天气、票价、开放时间等易变信息禁止出现在本结构中。","properties":{"activities":{"items":{"minLength":1,"type":"string"},"minItems":1,"type":"array"},"adcode":{"pattern":"^[0-9]{6}$","type":["string","null"]},"bestSeasons":{"items":{"enum":["spring","summer","autumn","winter"],"type":"string"},"minItems":1,"type":"array"},"city":{"minLength":1,"type":"string"},"district":{"type":["string","null"]},"highlights":{"items":{"minLength":1,"type":"string"},"maxItems":6,"minItems":2,"type":"array"},"id":{"description":"全局唯一，一经发布不得改名","pattern":"^[a-z0-9]+(-[a-z0-9]+)*$","type":"string"},"images":{"description":"draft 可为空数组；published 至少 1 项且每项 license/sourceUrl 必填。AI 生成图禁止充作实景图。","items":{"additionalProperties":false,"properties":{"alt":{"type":"string"},"credit":{"type":"string"},"isIllustration":{"default":false,"type":"boolean"},"license":{"type":"string"},"sourceUrl":{"format":"uri","type":"string"},"src":{"type":"string"},"thumb":{"type":"string"}},"required":["src","thumb","alt","credit","license","sourceUrl"],"type":"object"},"type":"array"},"location":{"additionalProperties":false,"properties":{"coordSystem":{"enum":["GCJ-02","WGS-84"],"type":"string"},"lat":{"maximum":54,"minimum":3,"type":"number"},"lng":{"maximum":136,"minimum":73,"type":"number"}},"required":["lat","lng","coordSystem"],"type":"object"},"name":{"minLength":1,"type":"string"},"province":{"description":"须与 data/provinces.json 的 name 逐字一致","type":"string"},"seasonNotes":{"type":["string","null"]},"source":{"additionalProperties":false,"properties":{"name":{"minLength":1,"type":"string"},"retrievedAt":{"format":"date","type":"string"},"url":{"format":"uri","type":"string"}},"required":["name","url","retrievedAt"],"type":"object"},"status":{"enum":["draft","published","hidden"],"type":"string"},"suggestedDays":{"additio